# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB connection string (e.g., mongodb://localhost:27017/medismart_ai or MongoDB Atlas connection string)
# When not connected, MediSmart AI seamlessly uses its high-performance built-in persistent storage.
MONGODB_URI="mongodb://127.0.0.1:27017/medismart_ai"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="medismart_ai_super_secure_jwt_secret_vizag_2026"

# ML_PREDICTION_SERVICE_URL: Optional external Python FastAPI waiting-time prediction service
ML_PREDICTION_SERVICE_URL="http://127.0.0.1:8000"
